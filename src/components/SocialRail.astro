---
import Icon from './Icon.astro';
import { socials } from '../data/site';
import type { IconName } from '../data/icons';

interface Props {
  /** Nombre accesible del bloque. */
  label?: string;
  /** Tamaño del icono. */
  size?: string;
  class?: string;
}

const { label = 'Redes de PAZ', size, class: className } = Astro.props;
---

<nav
  class:list={['rail', className]}
  style={size ? `--rail-icon:${size}` : undefined}
  aria-label={label}
>
  <ul class="rail__list">
    {
      socials.map((s) => (
        <li>
          <a class="rail__link tap-target" href={s.href} target="_blank" rel="noopener noreferrer">
            <Icon name={s.id as IconName} size="var(--rail-icon)" />
            <span class="sr-only">{s.label} (se abre en una pestaña nueva)</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .rail {
    /* Tamaño óptico unificado; en el original cada logo traía su propio
       tamaño de bitmap (80, 56, 60 y 88 px sobre el canvas de 1425). */
    --rail-icon: clamp(2rem, 4.2vw, 3.75rem);
  }

  .rail__list {
    display: flex;
    flex-flow: row wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(0.25rem, 2vw, 1.25rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .rail__link {
    display: grid;
    place-items: center;
    padding: 0.5rem;
    /* Mismo gris que la tagline: 5,8:1 sobre el rojo del hero. */
    color: var(--color-text-soft);
    transition:
      color var(--duration-fast) var(--ease-editorial),
      transform var(--duration-fast) var(--ease-editorial);
  }

  .rail__link:hover,
  .rail__link:focus-visible {
    color: var(--color-paper);
  }

  /* El desplazamiento es un refuerzo, nunca la única señal de estado. */
  @media (prefers-reduced-motion: no-preference) and (pointer: fine) {
    .rail__link:hover {
      transform: translateY(-0.15rem);
    }
  }
</style>
